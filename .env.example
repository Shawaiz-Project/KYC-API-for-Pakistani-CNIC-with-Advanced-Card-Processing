# Django
KYC_SECRET_KEY=replace-with-a-long-random-value
KYC_DEBUG=false
KYC_ALLOWED_HOSTS=localhost,127.0.0.1
KYC_TIME_ZONE=Asia/Karachi
KYC_LOG_LEVEL=INFO

# Keep false for local HTTP development. Enable behind correctly configured
# HTTPS in production; enable proxy trust only for a controlled reverse proxy.
KYC_SECURE_SSL_REDIRECT=false
KYC_SESSION_COOKIE_SECURE=false
KYC_CSRF_COOKIE_SECURE=false
KYC_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
KYC_SECURE_HSTS_SECONDS=0
KYC_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
KYC_SECURE_HSTS_PRELOAD=false
KYC_TRUST_PROXY_SSL_HEADER=false

# Authentication (comma-separated; use a generated secret, never this example text)
KYC_API_KEYS=replace-with-a-random-api-key
KYC_API_KEY_HEADER=X-API-Key
KYC_RATE_LIMIT=30/minute
KYC_AUTH_RATE_LIMIT=10/minute

# Upload and private retention controls
KYC_MAX_UPLOAD_BYTES=10485760
KYC_MAX_REQUEST_BYTES=33554432
KYC_MAX_UPLOAD_FILES=4
KYC_MAX_FORM_FIELDS=10
KYC_MAX_IMAGE_DIMENSION=10000
KYC_MAX_IMAGE_PIXELS=40000000
KYC_MIN_CARD_WIDTH=640
KYC_MIN_CARD_HEIGHT=400
KYC_PRIVATE_STORAGE_ROOT=./var/private-kyc
KYC_PRESERVE_UPLOADS=true
KYC_RETENTION_HOURS=24

# Persistence. SQLite + eager jobs are the reproducible development profile;
# use PostgreSQL + Redis/RabbitMQ for staging and production.
KYC_DATABASE_ENGINE=sqlite
KYC_SQLITE_PATH=./var/shanakht.sqlite3
KYC_DATABASE_NAME=shanakht
KYC_DATABASE_USER=shanakht
KYC_DATABASE_PASSWORD=
KYC_DATABASE_HOST=127.0.0.1
KYC_DATABASE_PORT=5432
KYC_TASK_ALWAYS_EAGER=true
KYC_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
KYC_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
KYC_TASK_TIME_LIMIT_SECONDS=300
KYC_TASK_SOFT_TIME_LIMIT_SECONDS=270

# Private object storage. The filesystem backend is private and streamed only
# after authorization. The S3 backend supports AWS S3 and compatible services.
KYC_OBJECT_STORAGE_BACKEND=filesystem
KYC_OBJECT_STORAGE_ROOT=./var/private-objects
KYC_S3_BUCKET=
KYC_S3_ENDPOINT_URL=
KYC_S3_REGION=
KYC_S3_ACCESS_KEY_ID=
KYC_S3_SECRET_ACCESS_KEY=
KYC_S3_SERVER_SIDE_ENCRYPTION=AES256

# Image-quality gates. Disable only for diagnostics.
KYC_QUALITY_GATES_ENABLED=true
KYC_BLUR_THRESHOLD=80.0
KYC_DARK_MEAN_THRESHOLD=45.0
KYC_BRIGHT_MEAN_THRESHOLD=225.0
KYC_GLARE_RATIO_THRESHOLD=0.08
KYC_MIN_CARD_AREA_RATIO=0.12

# Inference. CPU is the safe default; auto/cuda are opt-in.
KYC_DEVICE=cpu
KYC_OCR_ENABLED=true
KYC_OCR_REQUIRED=true
KYC_OCR_LANGUAGES=en,ur
KYC_OCR_ROTATION_INFO=180
KYC_OCR_MODEL_DIR=./var/models/easyocr
KYC_OCR_DOWNLOAD_ENABLED=false

# Optional custom YOLOv8 ONNX card detector. The OpenCV contour baseline is used
# when no path is configured. Set REQUIRED=true to make readiness depend on it.
KYC_CARD_DETECTOR_MODEL=
KYC_CARD_DETECTOR_SHA256=
KYC_CARD_DETECTOR_REQUIRED=false
KYC_CARD_DETECTOR_CONFIDENCE=0.20
KYC_CARD_DETECTOR_IOU=0.30

# Phase 2 detectors and policy. Missing/checksum-mismatched models produce
# unavailable checks; they never produce placeholder scores.
KYC_ENABLED_DETECTORS=document_consistency,layout_landmarks,selfie_quality,face_comparison,liveness,tampering,duplicate
KYC_REQUIRED_CHECKS=document_consistency,selfie_quality,face_comparison,liveness
KYC_POLICY_VERSION=phase2-policy-v1
KYC_FACE_DETECTOR_MODEL=./var/models/face/yunet.onnx
KYC_FACE_DETECTOR_SHA256=
KYC_FACE_RECOGNITION_MODEL=./var/models/face/sface.onnx
KYC_FACE_RECOGNITION_SHA256=
KYC_FACE_MATCH_THRESHOLD=0.363
KYC_FACE_UNCERTAIN_MARGIN=0.04
KYC_ANTI_SPOOF_MODEL=./var/models/liveness/anti-spoof.onnx
KYC_ANTI_SPOOF_SHA256=
KYC_LIVENESS_SESSION_SECONDS=120
KYC_LIVENESS_ACTIONS=turn_left,turn_right,look_center

# Generate independent random values. The webhook key must be a Fernet key.
KYC_IDENTIFIER_HMAC_KEY=
KYC_WEBHOOK_ENCRYPTION_KEY=
KYC_WEBHOOK_TIMEOUT_SECONDS=5
KYC_WEBHOOK_ALLOW_HTTP=false
KYC_MAX_BATCH_SIZE=20

# Extensions are disabled until their formats/provider access are evaluated.
KYC_FEATURE_PASSPORT_MRZ=false
KYC_FEATURE_PUNJAB_DRIVING_LICENSE=false
KYC_AUTHORITATIVE_PROVIDER=unavailable
KYC_CREATE_ACCOUNTS_ENABLED=false
