# Django
KYC_SECRET_KEY=replace-with-a-long-random-value
KYC_DEBUG=false
KYC_ALLOWED_HOSTS=localhost,127.0.0.1
KYC_TIME_ZONE=Asia/Karachi
KYC_LOG_LEVEL=INFO

# Authentication (comma-separated; use a generated secret, never this example text)
KYC_API_KEYS=replace-with-a-random-api-key
KYC_API_KEY_HEADER=X-API-Key
KYC_RATE_LIMIT=30/minute

# Upload and private retention controls
KYC_MAX_UPLOAD_BYTES=10485760
KYC_MAX_REQUEST_BYTES=22020096
KYC_MAX_IMAGE_DIMENSION=10000
KYC_MAX_IMAGE_PIXELS=40000000
KYC_MIN_CARD_WIDTH=640
KYC_MIN_CARD_HEIGHT=400
KYC_PRIVATE_STORAGE_ROOT=./var/private-kyc
KYC_PRESERVE_UPLOADS=true
KYC_RETENTION_HOURS=24

# Image-quality gates. Disable only for diagnostics.
KYC_QUALITY_GATES_ENABLED=true
KYC_BLUR_THRESHOLD=80.0
KYC_DARK_MEAN_THRESHOLD=45.0
KYC_BRIGHT_MEAN_THRESHOLD=225.0
KYC_GLARE_RATIO_THRESHOLD=0.08
KYC_MIN_CARD_AREA_RATIO=0.12

# Inference. CPU is the safe default; auto/cuda are opt-in.
KYC_DEVICE=cpu
KYC_OCR_ENABLED=true
KYC_OCR_REQUIRED=true
KYC_OCR_LANGUAGES=en,ur
KYC_OCR_MODEL_DIR=./var/models/easyocr
KYC_OCR_DOWNLOAD_ENABLED=false

# Optional custom YOLOv8 ONNX card detector. The OpenCV contour baseline is used
# when no path is configured. Set REQUIRED=true to make readiness depend on it.
KYC_CARD_DETECTOR_MODEL=
KYC_CARD_DETECTOR_SHA256=
KYC_CARD_DETECTOR_REQUIRED=false
KYC_CARD_DETECTOR_CONFIDENCE=0.20
KYC_CARD_DETECTOR_IOU=0.30
